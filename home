</div>

<div class="name">

Mungguys

</div>

<div class="handle">

IG / TikTok<br>

@mungguys

</div>

</div>

</section>

<footer>

WAYU • Conservatory of Music • Rangsit University

</footer>

</div>

</body>
</html>
